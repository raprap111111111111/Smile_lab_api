# ==============================================================================
# Smile Lab API - Production Environment Variables for Render
# Copy and paste these into your Render Dashboard under:
# Service -> Environment -> "Add Environment Variable" or "Add from .env"
# ==============================================================================

# Core Application
APP_NAME="Smile Concept API"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:ivkFm2dkEhxPuaElKe4mC7aKuyg4Aj/QSj6CHaW026E=
APP_URL=https://your-service-name.onrender.com
APP_FRONTEND_URL=https://your-flutter-app.com

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (From your Cloud MySQL Provider, e.g. Aiven.io)
DB_CONNECTION=mysql
DB_HOST=mysql-your-cluster.aivencloud.com
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_secure_password

# State & Session Drivers
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# CORS Allowed Origins (Comma-separated origins for web & mobile clients)
# Example: https://app.smileconcept.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://your-frontend-app.com

# Authentication (Laravel Passport)
# Paste the content of storage/oauth-private.key and storage/oauth-public.key
# (Render supports multiline environment variables)
# PASSPORT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# PASSPORT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Maintenance Driver
APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12
